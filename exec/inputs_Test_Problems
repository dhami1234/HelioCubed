## Idealized test problems selected by init_condition_type:
##   0 = smooth spherically symmetric wave
##   1 = non-radial spherical wave
##   5 = symmetric strong shock
##   6 = symmetric strong shock with B_cart = (1e-2, 0, 0) G
-convTestType                    0
-init_condition_type             5
-domainSize                      30
-thickness                       60
-boxSize_nonrad                  30
-boxSize_rad                     20
-max_iter                        100
-max_time                        3600000.0
-CFL                             0.5
-limiter                         1
-spatial_operator                1
-Berta_eta_d                     0.02
-Berta_detector_type             0
-Berta_fallback_type             0
-strength                        100.0
-write_cadence                   10
-slice_cadence                   1000000000
-write_time_cadence              1000000000.0
-slice_time_cadence              1000000000.0
-slices                          Z
-checkpoint_cadence              100
-P_floor_cadence                 1000000000
-data_file_prefix                test_data
-checkpoint_file_prefix          test_checkpoint
-scale_data_with_r               0
-output_divB                     1
-max_checkpoint_files            1
-gamma                           1.6666666666666666666667
-temporal_order                  4
-divergence_cleaning             1
-linear_viscosity                1
# 0 uses the historical radius-independent viscosity scaling, which is
# recommended for radial-symmetry tests; 1 enables radius-scaled viscosity.
-scale_viscosity_with_r          0
-boundary_reflux                 1
-radial_refinement               0
-MBInterp_define                 1
-num_probes                      0
-Sun_gravity                     0
-CME_type                        0
