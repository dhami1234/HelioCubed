## Idealized test problems selected by init_condition_type:
##   2 = radial pulse
##   3 = radial pulse with B_cart set by c_RADIAL_PULSE_BX0
##   4 = non-radial pulse
##   5 = non-radial pulse with B_cart set by c_NONRADIAL_PULSE_BX0
##   6 = strong spherical shock
##   7 = strong spherical shock with B_cart set by c_STRONG_SHOCK_BX0
##   8 = off-center hydrodynamic blast
##   9 = off-center blast with B_cart = (0.1, 0, 0) G
## For 8/9 use the test runner, which sets gamma/time per case.
-convTestType                    0
-init_condition_type             6
-domainSize                      30
-thickness                       60
-boxSize_nonrad                  30
-boxSize_rad                     20
-max_iter                        100
-max_time                        3600000.0
-CFL                             0.5
-limiter                         1
-spatial_operator                1
# Standard operator: 1 = Rusanov (default), 2 = Roe 8-wave.
-Riemann_solver_type             2
-entropy_fix_coeff               0.3
-Berta_eta_d                     0.02
-Berta_detector_type             0
-Berta_fallback_type             0
-strength                        100.0
-write_cadence                   1000000000
-slice_cadence                   1000000000
-write_time_cadence              1800.0
-slice_time_cadence              1800.0
-slices                          Z
-checkpoint_cadence              100
-P_floor_cadence                 1000000000
-data_file_prefix                test_data
-checkpoint_file_prefix          test_checkpoint
-scale_data_with_r               0
-output_divB                     1
-max_checkpoint_files            1
-gamma                           1.6666666666666666666667
-temporal_order                  4
-divergence_cleaning             1
-linear_viscosity                1
# 0 uses the historical radius-independent viscosity scaling, which is
# recommended for radial-symmetry tests; 1 enables radius-scaled viscosity.
-scale_viscosity_with_r          0
-boundary_reflux                 1
-radial_refinement               0
-MBInterp_define                 1
-num_probes                      0
-Sun_gravity                     0
-CME_type                        0
