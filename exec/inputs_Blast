## FLASH-style off-center blast: 8 = hydro, 9 = constant Cartesian B (0.1 G).
## rho = 700*m_p; p_out = 1e-7; p_in = 1e-3, in CGS units.
## Radius = 0.1*(R1-R0); center matches the non-radial pulse.
## max_time below is FLASH t=0.01 converted for the default shell dimensions.
## For another shell: t_stop = 0.1*R_blast / sqrt(10*c_TEST_P0/c_TEST_RHO0).
## Reference: https://flash.rochester.edu/site/flashcode/user_support/flash_ug_devel/node192.html
-convTestType                    0
-init_condition_type            8
-domainSize                      30
-thickness                       60
-boxSize_nonrad                  30
-boxSize_rad                     60
-max_iter                       10000
-max_time                       5001.23
-CFL                             0.5
-limiter                         1
-spatial_operator                1
-Berta_eta_d                     0.02
-Berta_detector_type             0
-Berta_fallback_type             0
-strength                        100.0
-write_cadence                  1000
-slice_cadence                   1000000000
-write_time_cadence              1000000000.0
-slice_time_cadence              1000000000.0
-slices                          Z
-checkpoint_cadence              100
-P_floor_cadence                 1000000000
-data_file_prefix               blast_data
-checkpoint_file_prefix         blast_checkpoint
-scale_data_with_r               0
-output_divB                     1
-max_checkpoint_files            1
-gamma                          1.4
-temporal_order                  4
-divergence_cleaning             1
-linear_viscosity                1
# 0 uses the historical radius-independent viscosity scaling, which is
# recommended for radial-symmetry tests; 1 enables radius-scaled viscosity.
-scale_viscosity_with_r          0
-boundary_reflux                 1
-radial_refinement               0
-MBInterp_define                 1
-num_probes                      0
-Sun_gravity                     0
-CME_type                        0
