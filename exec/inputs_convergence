# Optional runtime shell geometry (radii in cm; stretch is dimensionless).
# Omit these to use the Makefile defaults. radial_stretch = 0 is uniform.
#-inner_radius                   1.4964e12
#-outer_radius                   1.61124e13
#-radial_stretch                 1.5
## See Inputs_Parsing.H file for supported input values
-convTestType                    1
-convergence_level              -1
-convergence_dt                 -1.0
-init_condition_type             4
-domainSize                      30
-thickness                       45
-boxSize_nonrad                  30
-boxSize_rad                     45
-max_iter                        10
-max_time                        3600000.0
-CFL                             0.5
-limiter                         1
-spatial_operator                1
# Standard operator: 1 = Rusanov (default), 2 = Roe 8-wave.
-Riemann_solver_type             1
-entropy_fix_coeff               0.3
-Berta_eta_d                     0.02
-Berta_detector_type             0
-Berta_fallback_type             0
-write_cadence                   1
-checkpoint_cadence              50
-P_floor_cadence                 50
-data_file_prefix                data
-checkpoint_file_prefix          checkpoint
-output_divB                     0
-gamma                           1.6666666666666666666667
-temporal_order                  1
-divergence_cleaning             1
# Independent artificial-viscosity switches: 0 = off, 1 = on.
-linear_viscosity                0
-nonlinear_viscosity             0
# Linear viscosity order: 3 = third order, 5 = fifth order (default).
-viscosity_order                 5
-scale_viscosity_with_r          0
-boundary_reflux                 1
-radial_refinement               0
-MBInterp_define                 1
